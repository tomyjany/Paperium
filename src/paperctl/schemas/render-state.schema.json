{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperctl.local/schemas/render-state.schema.json",
  "title": "paperctl render state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "draft_output",
    "fingerprint",
    "manifest_sha256",
    "evidence_packet_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "const": "render_state" },
    "draft_output": { "$ref": "#/$defs/relative_path" },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "schema_version",
        "renderer_version",
        "config_sha256",
        "manifest_path",
        "manifest_sha256",
        "evidence_packet_sha256",
        "draft_path",
        "draft_sha256",
        "input_counts",
        "fingerprint_sha256"
      ],
      "properties": {
        "stage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "render" },
            "version": { "type": "integer", "minimum": 1 }
          }
        },
        "schema_version": { "const": 1 },
        "renderer_version": { "type": "string", "minLength": 1 },
        "config_sha256": { "$ref": "#/$defs/hash" },
        "manifest_path": { "$ref": "#/$defs/relative_path" },
        "manifest_sha256": { "$ref": "#/$defs/hash" },
        "evidence_packet_sha256": {
          "type": "array",
          "items": { "$ref": "#/$defs/hash" }
        },
        "draft_path": { "$ref": "#/$defs/relative_path" },
        "draft_sha256": { "$ref": "#/$defs/hash" },
        "input_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["experiment_count", "evidence_packet_count"],
          "properties": {
            "experiment_count": { "type": "integer", "minimum": 0 },
            "evidence_packet_count": { "type": "integer", "minimum": 0 }
          }
        },
        "fingerprint_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "manifest_sha256": { "$ref": "#/$defs/hash" },
    "evidence_packet_sha256": {
      "type": "array",
      "items": { "$ref": "#/$defs/hash" }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
